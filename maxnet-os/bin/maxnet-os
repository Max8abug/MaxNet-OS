#!/usr/bin/env bash
set -euo pipefail

APP_NAME="MaxOS"
DEFAULT_URL="https://moonbat.ddns.net"
FEATURE=""
PRINT_URL=0
THEME_ID=""

usage() {
  cat <<'EOF'
MaxOS desktop launcher

Usage:
  maxnet-os [--feature NAME]
  maxnet-os configure
  maxnet-os --choose-theme
  maxnet-os --theme THEME_ID
  maxnet-os --sync-theme URI
  maxnet-os --sync-account
  maxnet-os --handle-sync URI
  maxnet-os --restore-system-theme

Features: home, signin, chat, forum, dms, network, network-people,
          network-wiki, gallery, users, visits, guestbook, planner, news,
          games, eaglercraft, mypage, youtube, polls, music, playlists,
          drawing, settings
Themes: classic-light, classic-dark, xp-light, xp-dark, vista, vista-dark,
        gold, silver
  maxnet-os --updates
EOF
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/maxnet-os"
user_config="$config_dir/settings.conf"
theme_config="$config_dir/theme"
setup_complete="$config_dir/setup-prompt-complete"
pending_sync="$config_dir/pending-sync"
account_config="$config_dir/account.json"
system_config="/etc/maxnet-os/settings.conf"
version_file="/usr/share/maxnet-os/VERSION"
base_url="${MAXNET_URL:-}"

if [[ -z "$base_url" ]]; then
  if [[ -r "$user_config" ]]; then
    IFS= read -r base_url < "$user_config" || true
  elif [[ -r "$system_config" ]]; then
    IFS= read -r base_url < "$system_config" || true
  else
    base_url="$DEFAULT_URL"
  fi
fi

validate_url() {
  python3 - "$1" <<'PY'
from urllib.parse import urlsplit
import sys

value = sys.argv[1].strip()
try:
    parsed = urlsplit(value)
    valid = (
        parsed.scheme == "https"
        and bool(parsed.hostname)
        and parsed.username is None
        and parsed.password is None
        and not parsed.query
        and not parsed.fragment
    )
except ValueError:
    valid = False
if not valid:
    raise SystemExit(1)
PY
}

validate_theme() {
  case "$1" in
    classic-light|classic-dark|xp-light|xp-dark|vista|vista-dark|gold|silver) return 0 ;;
    *) return 1 ;;
  esac
}

theme_slug() {
  if [[ -r "$theme_config" ]]; then
    IFS= read -r THEME_ID < "$theme_config" || true
    if validate_theme "$THEME_ID"; then
      return
    fi
    printf '%s\n' "Invalid MaxOS theme setting: $THEME_ID" >&2
    exit 1
  fi
  THEME_ID="classic-light"
}

theme_selected() {
  if [[ "$THEME_ID" == "$1" ]]; then
    printf 'TRUE'
  else
    printf 'FALSE'
  fi
}

set_system_theme() {
  local selected="$1"
  validate_theme "$selected" || {
    printf 'Unknown MaxOS theme: %s\n' "$selected" >&2
    usage >&2
    exit 2
  }
  THEME_ID="$selected"
  install -d -m 700 "$config_dir"
  (umask 077; printf '%s\n' "$THEME_ID" > "$theme_config")
  apply_system_theme
}

choose_system_theme() {
  command -v zenity >/dev/null 2>&1 || {
    printf '%s\n' "Install zenity to choose a MaxOS theme from the desktop." >&2
    exit 1
  }
  theme_slug
  local selected
  selected="$(zenity --list \
    --title="MaxOS themes" \
    --text="Choose a desktop theme. This also sets the theme used when MaxNet apps open." \
    --radiolist --column="Selected" --column="Theme ID" --column="Theme" \
    --hide-column=1 --print-column=2 \
    "$(theme_selected classic-light)" classic-light "Classic light" \
    "$(theme_selected classic-dark)" classic-dark "Classic dark" \
    "$(theme_selected xp-light)" xp-light "Windows XP light" \
    "$(theme_selected xp-dark)" xp-dark "Windows XP dark" \
    "$(theme_selected vista)" vista "Windows Vista" \
    "$(theme_selected vista-dark)" vista-dark "Windows Vista dark" \
    "$(theme_selected gold)" gold "Gold picture frame" \
    "$(theme_selected silver)" silver "Silver picture frame")" || exit 0
  [[ -n "$selected" ]] || exit 0
  set_system_theme "$selected"
}

first_run() {
  apply_start_menu_icon
  [[ -e "$setup_complete" ]] && {
    [[ -e "$theme_config" ]] || choose_system_theme
    return 0
  }

  if command -v zenity >/dev/null 2>&1 &&
     zenity --question \
       --title="MaxOS setup" \
       --text="Sign in to MaxNet to sync your site theme, background, account permissions, and available apps. Your MaxNet password and local OS PIN stay separate. Site permissions never grant Linux administrator or sudo access." \
       --ok-label="Connect MaxNet" \
       --cancel-label="Continue offline"; then
    if open_account_setup; then
      zenity --info --title="MaxOS setup" \
        --text="Finish sign-in in the MaxNet window and choose Sync my MaxNet settings. You can use MaxOS offline while setup continues." || true
    else
      zenity --warning --title="MaxOS setup" \
        --text="A browser could not be opened. You can continue offline and sync your MaxNet account later from the Start menu." || true
    fi
  fi

  install -d -m 700 "$config_dir"
  (umask 077; : > "$setup_complete")
  chmod 600 "$setup_complete"
  [[ -e "$theme_config" ]] || choose_system_theme
}

open_account_setup() {
  validate_url "$base_url" || {
    printf 'Invalid MaxNet address in configuration: %s\n' "$base_url" >&2
    return 1
  }
  command -v python3 >/dev/null 2>&1 || {
    printf '%s\n' "Python 3 is required to start secure MaxNet account sync." >&2
    return 1
  }
  register_sync_handler
  local state url profile firefox_profile browser
  state="$(python3 -c 'import secrets; print(secrets.token_urlsafe(32))')"
  install -d -m 700 "$config_dir"
  (umask 077; printf '%s\n%s\n' "$state" "${base_url%/}" > "$pending_sync")
  chmod 600 "$pending_sync"
  url="${base_url%/}/?maxnet-os-setup=1&maxnet-os-state=$state"
  profile="${XDG_DATA_HOME:-$HOME/.local/share}/maxnet-os/chromium"
  for browser in chromium chromium-browser google-chrome-stable google-chrome brave-browser; do
    if command -v "$browser" >/dev/null 2>&1; then
      install -d -m 700 "$profile"
      "$browser" --app="$url" --new-window \
        --user-data-dir="$profile" --class="maxnet-os-setup" --name="MaxOS Setup" \
        >/dev/null 2>&1 &
      return 0
    fi
  done
  if command -v firefox >/dev/null 2>&1; then
    firefox_profile="${XDG_DATA_HOME:-$HOME/.local/share}/maxnet-os/firefox"
    install -d -m 700 "$firefox_profile"
    firefox --new-window --profile "$firefox_profile" "$url" >/dev/null 2>&1 &
    return 0
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
    return 0
  fi
  printf '%s\n' "No supported browser was found for MaxNet account setup." >&2
  return 1
}

apply_start_menu_icon() {
  command -v gsettings >/dev/null 2>&1 || return 0
  theme_slug
  local settings_changed=0

  if gsettings writable org.cinnamon app-menu-label >/dev/null 2>&1; then
    local current_label
    current_label="$(gsettings get org.cinnamon app-menu-label 2>/dev/null || true)"
    if [[ "$current_label" != "'Start'" ]]; then
      if gsettings set org.cinnamon app-menu-label "Start"; then
        settings_changed=1
      else
        printf '%s\n' "Could not set the Cinnamon Start menu label." >&2
      fi
    fi
  fi

  local icon_name="maxnet-os-start"
  local icon_sync
  if command -v maxnet-os-sync-logo >/dev/null 2>&1; then
    icon_sync="$(command -v maxnet-os-sync-logo)"
  elif [[ -x "$script_dir/maxnet-os-sync-logo" ]]; then
    icon_sync="$script_dir/maxnet-os-sync-logo"
  else
    icon_sync=""
  fi
  if [[ -n "$icon_sync" ]]; then
    icon_name="$("$icon_sync" "$base_url" "$THEME_ID" 2>/dev/null || printf '%s' "$icon_name")"
    [[ -n "$icon_name" ]] || icon_name="maxnet-os-start"
  fi

  if gsettings writable org.cinnamon app-menu-icon-name >/dev/null 2>&1; then
    local current_icon
    current_icon="$(gsettings get org.cinnamon app-menu-icon-name 2>/dev/null || true)"
    if [[ "$current_icon" != "'$icon_name'" ]]; then
      if gsettings set org.cinnamon app-menu-icon-name "$icon_name"; then
        settings_changed=1
      else
        printf '%s\n' "Could not set the Cinnamon Start menu icon." >&2
      fi
    fi
  fi

  # Cinnamon's menu applet reads these global settings at startup but does not
  # refresh its icon when they change. Restart Cinnamon only after a real
  # setting change so the site logo appears now, without a restart loop at login.
  if (( settings_changed )); then
    if command -v cinnamon >/dev/null 2>&1 &&
       { [[ -n "${DISPLAY:-}" ]] || [[ -n "${WAYLAND_DISPLAY:-}" ]]; }; then
      cinnamon --replace >/dev/null 2>&1 &
    else
      printf '%s\n' "The Start button branding will refresh at the next Cinnamon login."
    fi
  fi
}

show_update_error() {
  local message="$1"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="MaxOS Update Manager" --text="$message" || true
  else
    printf '%s\n' "$message" >&2
  fi
}

show_account_error() {
  local message="$1"
  if command -v zenity >/dev/null 2>&1; then
    zenity --error --title="MaxNet account sync" --text="$message" || true
  else
    printf '%s\n' "$message" >&2
  fi
}

check_for_updates() {
  local current_version latest_info remote_version package_name package_url checksum_url release_digest
  local tmp_dir checksum_file deb_file expected_digest actual_digest package_version error_file
  local arch command_name

  for command_name in python3 curl sha256sum dpkg dpkg-deb; do
    command -v "$command_name" >/dev/null 2>&1 || {
      show_update_error "The update manager needs $command_name, which is not installed."
      return 1
    }
  done
  command -v zenity >/dev/null 2>&1 || {
    printf '%s\n' "Install zenity to use the graphical update manager." >&2
    return 1
  }

  if [[ -r "$version_file" ]]; then
    IFS= read -r current_version < "$version_file" || true
  elif [[ -r "$script_dir/../VERSION" ]]; then
    IFS= read -r current_version < "$script_dir/../VERSION" || true
  else
    current_version="0.0.0"
  fi
  arch="$(dpkg --print-architecture)"
  error_file="$(mktemp "${TMPDIR:-/tmp}/maxnet-os-release-check.XXXXXX")"

  if ! latest_info="$(python3 - "$arch" 2>"$error_file" <<'PY'
import json
import re
import sys
from urllib.error import HTTPError, URLError
from urllib.parse import urlsplit
from urllib.request import Request, urlopen

api = "https://api.github.com/repos/Max8abug/MaxNet-OS/releases/latest"
try:
    request = Request(api, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": "MaxNet-OS-Update-Manager",
    })
    with urlopen(request, timeout=25) as response:
        release = json.load(response)
except HTTPError as error:
    if error.code == 404:
        print(
            "No stable MaxOS release has been published yet. "
            "The updater needs a release containing this system's .deb package "
            "and its .sha256 checksum.\n"
            "Release page: https://github.com/Max8abug/MaxNet-OS/releases",
            file=sys.stderr,
        )
    else:
        print(f"GitHub release check failed with HTTP {error.code}.", file=sys.stderr)
    raise SystemExit(1)
except (URLError, TimeoutError, json.JSONDecodeError) as error:
    print(f"Could not reach the MaxOS release service: {error}", file=sys.stderr)
    raise SystemExit(1)

tag = release.get("tag_name", "")
match = re.fullmatch(r"v?(\d+\.\d+\.\d+(?:[-+][A-Za-z0-9.-]+)?)", tag)
if not match or release.get("draft") or release.get("prerelease"):
    print("The latest GitHub release has an invalid version or is not stable.", file=sys.stderr)
    raise SystemExit(1)

version = match.group(1)
arch = sys.argv[1]
package_name = f"maxnet-os_{version}_{arch}.deb"
assets = {asset.get("name"): asset for asset in release.get("assets", [])}
package = assets.get(package_name)
checksum = assets.get(package_name + ".sha256")
if not package or not checksum:
    print(f"Release {tag} is missing the package or its SHA-256 file for {arch}.", file=sys.stderr)
    raise SystemExit(1)

def trusted_release_url(asset):
    value = asset.get("browser_download_url", "")
    parsed = urlsplit(value)
    if (parsed.scheme != "https" or parsed.hostname != "github.com" or
            parsed.username or parsed.password or
            not parsed.path.startswith("/Max8abug/MaxNet-OS/releases/download/")):
        raise SystemExit("GitHub returned an unexpected release download URL.")
    return value

digest = package.get("digest") or ""
if digest and not re.fullmatch(r"sha256:[0-9a-fA-F]{64}", digest):
    raise SystemExit("GitHub returned an invalid package digest.")
print("\t".join((
    version,
    package_name,
    trusted_release_url(package),
    trusted_release_url(checksum),
    digest.removeprefix("sha256:").lower(),
)))
PY
)"; then
    latest_info="$(cat "$error_file" 2>/dev/null || true)"
    rm -f "$error_file"
    show_update_error "${latest_info:-Could not check GitHub for MaxOS updates.}"
    return 1
  fi
  rm -f "$error_file"
  IFS=$'\t' read -r remote_version package_name package_url checksum_url release_digest <<< "$latest_info"
  if ! dpkg --compare-versions "$remote_version" gt "$current_version"; then
    zenity --info --title="MaxOS Update Manager" \
      --text="MaxOS is up to date.\n\nInstalled version: $current_version\nLatest release: $remote_version" || true
    return 0
  fi

  if ! zenity --question --title="MaxOS Update Available" \
    --text="Version $remote_version is available (installed: $current_version).\n\nDownload and verify the package before installing it?"; then
    return 0
  fi

  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/maxnet-os-update.XXXXXX")"
  trap 'rm -rf "$tmp_dir"' EXIT
  checksum_file="$tmp_dir/$package_name.sha256"
  deb_file="$tmp_dir/$package_name"
  if ! curl --fail --location --silent --show-error \
      --proto '=https' --proto-redir '=https' "$checksum_url" -o "$checksum_file" ||
     ! curl --fail --location --silent --show-error \
      --proto '=https' --proto-redir '=https' "$package_url" -o "$deb_file"; then
    show_update_error "The release download failed. No system files were changed."
    return 1
  fi

  expected_digest="$(awk -v file="$package_name" '$2 == file { print $1; exit }' "$checksum_file")"
  actual_digest="$(sha256sum "$deb_file" | awk '{print $1}')"
  if [[ ! "$expected_digest" =~ ^[[:xdigit:]]{64}$ ||
        "$expected_digest" != "$actual_digest" ||
        ( -n "$release_digest" && "$release_digest" != "$actual_digest" ) ]]; then
    show_update_error "The downloaded package did not match the release SHA-256 checks. Installation was stopped."
    return 1
  fi
  package_version="$(dpkg-deb --field "$deb_file" Version 2>/dev/null || true)"
  if [[ "$(dpkg-deb --field "$deb_file" Package 2>/dev/null || true)" != "maxnet-os" ||
        "$package_version" != "$remote_version" ]]; then
    show_update_error "The downloaded file is not the expected MaxOS package version. Installation was stopped."
    return 1
  fi

  if ! command -v pkexec >/dev/null 2>&1; then
    show_update_error "PolicyKit (pkexec) is not installed, so the package cannot be installed graphically."
    return 1
  fi
  if pkexec apt-get install -y "$deb_file"; then
    zenity --info --title="MaxOS Updated" \
      --text="MaxOS $remote_version was installed successfully." || true
  else
    show_update_error "The package installation did not complete. Check the authentication prompt and package manager output."
    return 1
  fi
}

sync_system_theme() {
  local request="$1"
  local selected="${request#maxnet-os://theme/}"
  if [[ "$request" != maxnet-os://theme/* ]] || ! validate_theme "$selected"; then
    printf '%s\n' "Rejected an invalid MaxOS theme sync request." >&2
    exit 2
  fi
  command -v zenity >/dev/null 2>&1 || {
    printf '%s\n' "Install zenity to confirm theme changes from MaxNet." >&2
    exit 1
  }
  if zenity --question \
    --title="Sync MaxNet theme" \
    --text="Apply the signed-in MaxNet account's $selected theme to this MaxOS desktop?"; then
    set_system_theme "$selected"
  fi
}

sync_account_settings() {
  local request="$1"
  local callback state code
  local pending_state pending_server api_url
  local import_dir request_file response_file
  local account_data background_dir account_summary selected_theme selected_background background_color

  if ! callback="$(python3 - "$request" <<'PY'
from urllib.parse import parse_qs, urlsplit
import re
import sys

url = urlsplit(sys.argv[1])
values = parse_qs(url.query, strict_parsing=True)
state = values.get("state", [""])[0]
code = values.get("code", [""])[0]
if url.scheme != "maxnet-os" or url.netloc != "sync":
    raise SystemExit("Invalid MaxOS account-sync link.")
if not re.fullmatch(r"[A-Za-z0-9_-]{43}", state) or not re.fullmatch(r"[A-Za-z0-9_-]{43}", code):
    raise SystemExit("The MaxOS account-sync link is invalid or incomplete.")
print(state)
print(code)
PY
  )"; then
    show_account_error "The MaxOS account-sync link is invalid."
    return 1
  fi
  mapfile -t callback_fields <<< "$callback"
  state="${callback_fields[0]:-}"
  code="${callback_fields[1]:-}"

  if [[ ! -r "$pending_sync" ]]; then
    show_account_error "This MaxOS setup request is no longer active. Open Sync MaxNet Account from the Start menu and try again."
    return 1
  fi
  mapfile -t pending_fields < "$pending_sync"
  pending_state="${pending_fields[0]:-}"
  pending_server="${pending_fields[1]:-}"
  if [[ "$state" != "$pending_state" ]] || ! validate_url "$pending_server"; then
    show_account_error "This MaxOS setup link does not match the request from this computer."
    return 1
  fi

  install -d -m 700 "$config_dir"
  import_dir="$(mktemp -d "${TMPDIR:-/tmp}/maxnet-os-sync.XXXXXX")"
  chmod 700 "$import_dir"
  request_file="$import_dir/request.json"
  response_file="$import_dir/response.json"
  python3 - "$code" "$state" > "$request_file" <<'PY'
import json
import sys
json.dump({"code": sys.argv[1], "state": sys.argv[2]}, sys.stdout)
PY
  chmod 600 "$request_file"
  api_url="${pending_server%/}/api/os/setup/redeem"
  if ! curl --fail --silent --show-error --max-time 45 --connect-timeout 10 \
    --proto '=https' \
    --header 'Content-Type: application/json' \
    --data-binary "@$request_file" \
    "$api_url" -o "$response_file"; then
    rm -rf "$import_dir"
    show_account_error "MaxNet could not return the account settings. Check that the site is online, then start account sync again."
    return 1
  fi
  chmod 600 "$response_file"

  if ! python3 - "$response_file" "$import_dir" <<'PY'
import base64
import json
import os
import re
import sys
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])
payload = json.loads(source.read_text())
if payload.get("version") != 1:
    raise SystemExit("Unsupported MaxNet account settings version.")

valid_apps = {
    "home", "signin", "chat", "forum", "dms", "network", "network-people",
    "network-wiki", "gallery", "users", "visits", "guestbook", "planner",
    "news", "games", "eaglercraft", "mypage", "youtube", "polls", "music",
    "playlists", "drawing", "settings",
}
username = payload.get("username")
if not isinstance(username, str) or not 2 <= len(username) <= 32 or any(ord(c) < 32 for c in username):
    raise SystemExit("Invalid MaxNet account name.")
rank = payload.get("rank")
if rank is not None and (not isinstance(rank, str) or len(rank) > 64):
    raise SystemExit("Invalid MaxNet account rank.")
permissions = payload.get("permissions")
if not isinstance(permissions, list) or len(permissions) > 64 or any(
    not isinstance(item, str) or len(item) > 64 for item in permissions
):
    raise SystemExit("Invalid MaxNet account permissions.")
apps = payload.get("apps")
if not isinstance(apps, list) or any(not isinstance(item, str) or item not in valid_apps for item in apps):
    raise SystemExit("Invalid MaxNet app list.")
appearance = payload.get("appearance")
if not isinstance(appearance, dict):
    raise SystemExit("Invalid MaxNet appearance settings.")
theme = appearance.get("displayTheme")
valid_themes = {
    "classic-light", "classic-dark", "xp-light", "xp-dark",
    "vista", "vista-dark", "gold", "silver",
}
if theme is not None and theme not in valid_themes:
    raise SystemExit("Invalid MaxNet display theme.")
color = appearance.get("backgroundColor")
if not isinstance(color, str) or not re.fullmatch(r"#[0-9A-Fa-f]{6}", color):
    color = None
time_zone = appearance.get("timeZone")
if not isinstance(time_zone, str) or len(time_zone) > 64:
    time_zone = None

def save_background(value, name):
    if not isinstance(value, str) or len(value) > 4_000_000:
        return None
    match = re.fullmatch(r"data:image/(png|jpeg|webp);base64,([A-Za-z0-9+/=\r\n]+)", value)
    if not match:
        return None
    image_type, encoded = match.groups()
    try:
        data = base64.b64decode(encoded, validate=True)
    except (ValueError, base64.binascii.Error):
        return None
    if len(data) > 3_000_000:
        return None
    signatures = {
        "png": data.startswith(b"\x89PNG\r\n\x1a\n"),
        "jpeg": data.startswith(b"\xff\xd8\xff"),
        "webp": len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP",
    }
    if not signatures[image_type]:
        return None
    extension = {"png": "png", "jpeg": "jpg", "webp": "webp"}[image_type]
    path = target / f"{name}.{extension}"
    path.write_bytes(data)
    os.chmod(path, 0o600)
    return path.name

light_background = save_background(appearance.get("backgroundUrl"), "background-light")
dark_background = save_background(appearance.get("darkBackgroundUrl"), "background-dark")
account = {
    "version": 1,
    "username": username,
    "rank": rank,
    "isMaxNetAdmin": payload.get("isMaxNetAdmin") is True,
    "permissions": sorted(set(permissions)),
    "apps": sorted(set(apps)),
    "archivedFeatures": [
        item for item in payload.get("archivedFeatures", [])
        if isinstance(item, str) and len(item) <= 64
    ][:128],
    "appearance": {
        "displayTheme": theme,
        "backgroundColor": color,
        "timeZone": time_zone,
        "backgroundLight": light_background,
        "backgroundDark": dark_background,
    },
    "syncedAt": payload.get("issuedAt") if isinstance(payload.get("issuedAt"), str) else "",
}
(target / "account.json").write_text(json.dumps(account, separators=(",", ":")) + "\n")
os.chmod(target / "account.json", 0o600)
PY
  then
    rm -rf "$import_dir"
    show_account_error "MaxNet returned account settings that MaxOS could not validate. Nothing was applied."
    return 1
  fi

  account_summary="$(python3 - "$import_dir/account.json" <<'PY'
import json
import sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
appearance = value["appearance"]
theme = appearance.get("displayTheme") or "keep current theme"
rank = value.get("rank") or "member"
print(f"Account: {value['username']}\nMaxNet rank: {rank}\nSite permissions: {len(value['permissions'])}\nAvailable MaxNet apps: {len(value['apps'])}\nDisplay theme: {theme}\n\nThis does not change Linux administrator or sudo access.")
PY
  )"
  if ! command -v zenity >/dev/null 2>&1 || ! zenity --question \
    --title="Apply MaxNet settings to MaxOS" \
    --width=520 \
    --text="$account_summary" \
    --ok-label="Apply settings" \
    --cancel-label="Keep local settings"; then
    rm -rf "$import_dir"
    rm -f "$pending_sync"
    return 0
  fi

  account_data="${XDG_DATA_HOME:-$HOME/.local/share}/maxnet-os"
  background_dir="$account_data/backgrounds"
  install -d -m 700 "$account_data" "$background_dir"
  selected_theme="$(python3 - "$import_dir/account.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["appearance"].get("displayTheme") or "")
PY
  )"
  if [[ -n "$selected_theme" ]]; then
    set_system_theme "$selected_theme" || {
      rm -rf "$import_dir"
      show_account_error "The MaxNet theme could not be applied. Your account settings were not saved."
      return 1
    }
  else
    theme_slug
    apply_system_theme
  fi

  local image_name=""
  if [[ "$THEME_ID" == *-dark ]]; then
    image_name="$(python3 - "$import_dir/account.json" <<'PY'
import json, sys
appearance = json.load(open(sys.argv[1], encoding="utf-8"))["appearance"]
print(appearance.get("backgroundDark") or appearance.get("backgroundLight") or "")
PY
    )"
  else
    image_name="$(python3 - "$import_dir/account.json" <<'PY'
import json, sys
appearance = json.load(open(sys.argv[1], encoding="utf-8"))["appearance"]
print(appearance.get("backgroundLight") or appearance.get("backgroundDark") or "")
PY
    )"
  fi
  if [[ -n "$image_name" && -f "$import_dir/$image_name" ]]; then
    cp "$import_dir/$image_name" "$background_dir/$image_name"
    chmod 600 "$background_dir/$image_name"
    selected_background="$background_dir/$image_name"
    gsettings set org.cinnamon.desktop.background picture-uri "file://$selected_background"
  else
    background_color="$(python3 - "$import_dir/account.json" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["appearance"].get("backgroundColor") or "")
PY
    )"
    if [[ "$background_color" =~ ^#[[:xdigit:]]{6}$ ]]; then
      selected_background="$background_dir/maxnet-account-background.svg"
      python3 - "$background_color" "$selected_background" <<'PY'
import os, re, sys
color = sys.argv[1]
if not re.fullmatch(r"#[0-9A-Fa-f]{6}", color):
    raise SystemExit(1)
with open(sys.argv[2], "w", encoding="utf-8") as output:
    output.write(f'<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080"><rect width="100%" height="100%" fill="{color}"/></svg>\n')
os.chmod(sys.argv[2], 0o600)
PY
      gsettings set org.cinnamon.desktop.background picture-uri "file://$selected_background"
    fi
  fi

  install -m 600 "$import_dir/account.json" "$account_config"
  sync_feature_visibility
  rm -f "$pending_sync"
  rm -rf "$import_dir"
  zenity --info --title="MaxOS account sync complete" \
    --text="MaxNet settings for $(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["username"])' "$account_config") were synced. Your Linux login and administrator permissions were not changed." || true
}

handle_sync_uri() {
  local request="$1"
  if [[ "$request" == maxnet-os://theme/* ]]; then
    sync_system_theme "$request"
  else
    sync_account_settings "$request"
  fi
}

sync_feature_visibility() {
  [[ -r "$account_config" ]] || return 0
  local feature_table="/usr/share/maxnet-os/features.tsv"
  [[ -r "$feature_table" ]] || feature_table="$script_dir/../share/applications/features.tsv"
  [[ -r "$feature_table" ]] || return 0
  local applications_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  install -d -m 700 "$applications_dir"
  python3 - "$account_config" "$feature_table" "$applications_dir" <<'PY'
import json
import os
import sys
from pathlib import Path

account = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
available = set(account.get("apps", []))
feature_table = Path(sys.argv[2])
applications = Path(sys.argv[3])
marker = "# Generated by MaxOS account sync; do not edit."
for line in feature_table.read_text(encoding="utf-8").splitlines():
    if not line or line.startswith("#"):
        continue
    feature = line.split("|", 1)[0]
    desktop = applications / f"maxnet-{feature}.desktop"
    if feature in available:
        if desktop.is_file() and marker in desktop.read_text(encoding="utf-8", errors="replace"):
            desktop.unlink()
        continue
    if desktop.exists() and marker not in desktop.read_text(encoding="utf-8", errors="replace"):
        continue
    desktop.write_text(f"[Desktop Entry]\nHidden=true\n{marker}\n", encoding="utf-8")
    os.chmod(desktop, 0o600)
PY
}

register_sync_handler() {
  if command -v xdg-mime >/dev/null 2>&1; then
    xdg-mime default maxnet-os-sync.desktop x-scheme-handler/maxnet-os >/dev/null 2>&1 || true
  fi
}

configure_url() {
  command -v zenity >/dev/null 2>&1 || {
    printf '%s\n' "Install zenity to configure MaxNet from the desktop." >&2
    exit 1
  }
  local entered
  entered="$(zenity --entry \
    --title="MaxOS connection" \
    --text="Enter the HTTPS address of your MaxNet server:" \
    --entry-text="$base_url")" || exit 0
  entered="${entered%/}"
  if ! validate_url "$entered"; then
    zenity --error --title="Invalid address" \
      --text="Use an HTTPS address with no username, password, query, or fragment." || true
    exit 1
  fi
  install -d -m 700 "$config_dir"
  (umask 077; printf '%s\n' "$entered" > "$user_config")
  zenity --info --title="MaxOS" --text="MaxNet server saved." || true
}

apply_system_theme() {
  command -v gsettings >/dev/null 2>&1 || {
    printf '%s\n' "Cinnamon settings are unavailable; run this on a Cinnamon desktop." >&2
    exit 1
  }
  local backup="$config_dir/original-theme"
  theme_slug
  local theme_name="MaxNet-$THEME_ID"
  install -d -m 700 "$config_dir"
  if [[ ! -e "$backup" ]]; then
    {
      printf 'gtk-theme=%s\n' "$(gsettings get org.cinnamon.desktop.interface gtk-theme)"
      printf 'cinnamon-theme=%s\n' "$(gsettings get org.cinnamon.theme name)"
      printf 'window-theme=%s\n' "$(gsettings get org.cinnamon.desktop.wm.preferences theme)"
      printf 'wallpaper=%s\n' "$(gsettings get org.cinnamon.desktop.background picture-uri)"
    } > "$backup"
    chmod 600 "$backup"
  elif ! grep -q '^window-theme=' "$backup"; then
    printf 'window-theme=%s\n' "$(gsettings get org.cinnamon.desktop.wm.preferences theme)" >> "$backup"
    chmod 600 "$backup"
  fi
  gsettings set org.cinnamon.desktop.interface gtk-theme "$theme_name"
  gsettings set org.cinnamon.theme name "$theme_name"
  gsettings set org.cinnamon.desktop.wm.preferences theme "$theme_name"
  gsettings set org.cinnamon.desktop.background picture-uri \
    "file:///usr/share/backgrounds/maxnet-os-$THEME_ID.svg"
  apply_start_menu_icon
  printf 'MaxNet %s theme applied. Use --restore-system-theme to restore the previous settings.\n' "$THEME_ID"
}

restore_system_theme() {
  local backup="$config_dir/original-theme"
  [[ -r "$backup" ]] || {
    printf '%s\n' "No saved Cinnamon theme settings were found." >&2
    exit 1
  }
  local gtk_theme="" cinnamon_theme="" window_theme="" wallpaper=""
  while IFS='=' read -r key value; do
    case "$key" in
      gtk-theme) gtk_theme="$value" ;;
      cinnamon-theme) cinnamon_theme="$value" ;;
      window-theme) window_theme="$value" ;;
      wallpaper) wallpaper="$value" ;;
    esac
  done < "$backup"
  [[ -n "$gtk_theme" && -n "$cinnamon_theme" && -n "$wallpaper" ]] || {
    printf '%s\n' "Saved theme settings are incomplete; refusing to change desktop settings." >&2
    exit 1
  }
  gsettings set org.cinnamon.desktop.interface gtk-theme "$gtk_theme"
  gsettings set org.cinnamon.theme name "$cinnamon_theme"
  [[ -z "$window_theme" ]] || gsettings set org.cinnamon.desktop.wm.preferences theme "$window_theme"
  gsettings set org.cinnamon.desktop.background picture-uri "$wallpaper"
  rm -f "$backup"
  rm -f "$theme_config"
  printf '%s\n' "Previous Cinnamon theme settings restored."
}

open_feature() {
  local feature="$1"
  case "$feature" in
    home|signin|chat|forum|dms|network|network-people|network-wiki|gallery|users|visits|guestbook|planner|news|games|eaglercraft|mypage|youtube|polls|music|playlists|drawing|settings) ;;
    *)
      printf 'Unknown MaxNet feature: %s\n' "$feature" >&2
      usage >&2
      exit 2
      ;;
  esac
  if ! validate_url "$base_url"; then
    printf 'Invalid MaxNet address in configuration: %s\n' "$base_url" >&2
    printf '%s\n' "Run: maxnet-os configure" >&2
    exit 1
  fi

  local url="${base_url%/}/?maxnet-os=1"
  if [[ "$feature" != "home" ]]; then
    local launch_id
    launch_id="$(date +%s%N)-$$"
    url+="&maxnet-feature=$feature&maxnet-view=app&maxnet-launch-id=$launch_id"
  fi
  if [[ -r "$theme_config" ]]; then
    theme_slug
    url+="&maxnet-theme=$THEME_ID"
  fi
  if (( PRINT_URL )); then
    printf '%s\n' "$url"
    return
  fi

  register_sync_handler
  local profile="${XDG_DATA_HOME:-$HOME/.local/share}/maxnet-os/chromium"
  local browser wm_class="maxnet-os" window_title="$APP_NAME"
  if [[ "$feature" != "home" ]]; then
    wm_class="maxnet-$feature"
    window_title="MaxNet - $feature"
  fi
  for browser in chromium chromium-browser google-chrome-stable google-chrome brave-browser; do
    if command -v "$browser" >/dev/null 2>&1; then
      install -d -m 700 "$profile"
      exec "$browser" --app="$url" --new-window \
        --user-data-dir="$profile" --class="$wm_class" --name="$window_title"
    fi
  done

  if command -v firefox >/dev/null 2>&1; then
    local firefox_profile="${XDG_DATA_HOME:-$HOME/.local/share}/maxnet-os/firefox"
    install -d -m 700 "$firefox_profile"
    exec firefox --new-window --profile "$firefox_profile" "$url"
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$url"
  fi
  printf '%s\n' "No supported browser was found. Install Chromium, Firefox, or xdg-utils." >&2
  exit 1
}

while (($#)); do
  case "$1" in
    --first-run)
      first_run
      exit 0
      ;;
    --sync-account)
      open_account_setup
      exit $?
      ;;
    --handle-sync)
      (($# >= 2)) || { usage >&2; exit 2; }
      handle_sync_uri "$2"
      exit $?
      ;;
    --updates)
      check_for_updates
      exit $?
      ;;
    configure)
      configure_url
      exit 0
      ;;
    --feature)
      (($# >= 2)) || { usage >&2; exit 2; }
      FEATURE="$2"
      shift 2
      ;;
    --choose-theme)
      choose_system_theme
      exit 0
      ;;
    --theme)
      (($# >= 2)) || { usage >&2; exit 2; }
      set_system_theme "$2"
      exit 0
      ;;
    --sync-theme)
      (($# >= 2)) || { usage >&2; exit 2; }
      sync_system_theme "$2"
      exit 0
      ;;
    --apply-system-theme)
      theme_slug
      set_system_theme "$THEME_ID"
      exit 0
      ;;
    --restore-system-theme)
      restore_system_theme
      exit 0
      ;;
    --print-url)
      PRINT_URL=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'Unexpected argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

open_feature "${FEATURE:-home}"
