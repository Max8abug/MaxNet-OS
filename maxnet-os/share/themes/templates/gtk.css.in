/* MaxNet display theme adapted for GTK applications. */
@define-color theme_bg_color @BG@;
@define-color theme_fg_color @FG@;
@define-color theme_base_color @SURFACE@;
@define-color theme_text_color @FG@;
@define-color theme_selected_bg_color @ACCENT@;
@define-color theme_selected_fg_color @ACCENT_FG@;
@define-color theme_borders @BORDER@;
@define-color window_bg_color @BG@;
@define-color window_fg_color @FG@;
@define-color view_bg_color @SURFACE@;
@define-color view_fg_color @FG@;
@define-color headerbar_bg_color @BG@;
@define-color headerbar_fg_color @FG@;
@define-color sidebar_bg_color @BG@;
@define-color sidebar_fg_color @FG@;
@define-color card_bg_color @SURFACE@;
@define-color card_fg_color @FG@;
@define-color popover_bg_color @SURFACE@;
@define-color popover_fg_color @FG@;
@define-color dialog_bg_color @BG@;
@define-color dialog_fg_color @FG@;
@define-color accent_color @ACCENT@;
@define-color borders @BORDER@;

* {
  font-family: @FONT@;
}

window,
dialog,
.background,
window.background,
dialog.background,
.csd,
.solid-csd {
  background-color: @BG@;
  background-image: none;
  color: @FG@;
}

headerbar,
.titlebar {
  background-image: none;
  background-color: @ACCENT@;
  color: @ACCENT_FG@;
  border-color: @BORDER@;
  border-radius: @RADIUS@;
}

window:backdrop,
dialog:backdrop,
.background:backdrop {
  background-color: @BG@;
  background-image: none;
  color: @FG@;
}

popover,
popover.background,
menu,
tooltip {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border: 1px solid @BORDER@;
}

button {
  background-image: @BUTTON_BG@;
  background-color: @SURFACE@;
  color: @FG@;
  border: @FRAME@;
  border-radius: @RADIUS@;
  padding: 4px 8px;
}

button:hover,
button:checked,
button:active {
  background-color: @ACCENT@;
  color: @ACCENT_FG@;
}

entry,
textview,
.view,
treeview.view {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border-color: @BORDER@;
}

selection,
*:selected {
  background-color: @ACCENT@;
  color: @ACCENT_FG@;
}

tooltip {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border: 1px solid @BORDER@;
}
