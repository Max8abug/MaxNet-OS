/* MaxNet display theme adapted for GTK applications. */
@define-color theme_bg_color @BG@;
@define-color theme_fg_color @FG@;
@define-color theme_base_color @SURFACE@;
@define-color theme_text_color @FG@;
@define-color theme_selected_bg_color @ACCENT@;
@define-color theme_selected_fg_color @ACCENT_FG@;
@define-color theme_borders @BORDER@;

* {
  font-family: @FONT@;
}

window,
dialog {
  background-color: @BG@;
  color: @FG@;
}

headerbar,
.titlebar {
  background-image: @PANEL_BG@;
  background-color: @ACCENT@;
  color: @ACCENT_FG@;
  border-color: @BORDER@;
  border-radius: @RADIUS@;
}

button {
  background-image: @BUTTON_BG@;
  background-color: @SURFACE@;
  color: @FG@;
  border: @FRAME@;
  border-radius: @RADIUS@;
  padding: 4px 8px;
}

button:hover,
button:checked,
button:active {
  background-color: @ACCENT@;
  color: @ACCENT_FG@;
}

entry,
textview,
.view,
treeview.view {
  background-color: @SURFACE@;
  color: @FG@;
  border-color: @BORDER@;
}

selection,
*:selected {
  background-color: @ACCENT@;
  color: @ACCENT_FG@;
}

tooltip {
  background-color: @SURFACE@;
  color: @FG@;
  border: 1px solid @BORDER@;
}
