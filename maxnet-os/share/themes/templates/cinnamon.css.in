/* MaxNet display theme adapted for Cinnamon. */
#panel,
.panel {
  background-color: @BG@;
  background-image: @BUTTON_BG@;
  color: @FG@;
  font-family: @FONT@;
  min-height: 42px;
  border-top: 1px solid @FRAME_HIGHLIGHT@;
  box-shadow: inset 0 1px @FRAME_HIGHLIGHT@, 0 -3px 14px @FRAME_SHADOW@;
}

#panel .panel-button,
.panel .panel-button {
  color: @FG@;
  background-color: transparent;
  background-image: none;
  border: 1px solid transparent;
  border-radius: @CONTROL_RADIUS@;
  margin: 3px 2px;
  padding: 5px 9px;
  box-shadow: none;
}

#panel .panel-button:hover,
#panel .panel-button:checked,
#panel .panel-button:focus,
.panel .panel-button:hover,
.panel .panel-button:checked,
.panel .panel-button:focus {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border-color: @BORDER@;
  box-shadow: 0 1px 3px @FRAME_SHADOW@;
}

#panel .panel-button:active,
.panel .panel-button:active {
  background-color: @ACCENT@;
  background-image: none;
  color: @ACCENT_FG@;
  border-color: @ACCENT@;
  box-shadow: inset 0 1px 2px @FRAME_SHADOW@;
}

#panel .panel-left > .applet-box:first-child.panel-button,
#panel .panel-left > .applet-box:first-child .panel-button {
  min-width: 88px;
  min-height: 30px;
  margin: 3px 6px 3px 3px;
  padding: 4px 12px;
  color: @FG@;
  background-color: @SURFACE@;
  background-image: @BUTTON_BG@;
  border: @FRAME@;
  border-radius: @RADIUS@;
  box-shadow: inset 0 1px @FRAME_HIGHLIGHT@, 0 2px 5px @FRAME_SHADOW@;
}

#panel .panel-left > .applet-box:first-child.panel-button:hover,
#panel .panel-left > .applet-box:first-child .panel-button:hover {
  color: @ACCENT_FG@;
  background-color: @ACCENT@;
  background-image: none;
  border-color: @BORDER@;
}

#panel .panel-left > .applet-box:first-child .applet-label {
  font-weight: 700;
}

#panel .applet-label {
  font-weight: 600;
}

#panel .applet-icon {
  icon-size: 20px;
}

.window-list-item-box {
  color: @FG@;
  background-color: transparent;
  background-image: none;
  border: 1px solid transparent;
  border-radius: @CONTROL_RADIUS@;
  margin: 3px 2px;
  padding: 4px 9px;
  box-shadow: none;
}

.window-list-item-box:hover,
.window-list-item-box:focus {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border-color: @BORDER@;
}

.window-list-item-box:active {
  background-color: @SURFACE@;
  background-image: none;
  border-color: @BORDER@;
  border-bottom: 2px solid @ACCENT@;
  box-shadow: 0 1px 3px @FRAME_SHADOW@;
}

#menu,
.menu,
.appmenu-background {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border: @FRAME@;
  border-radius: @RADIUS@;
  padding: 6px;
  box-shadow: inset 0 1px @FRAME_HIGHLIGHT@, 0 14px 32px @FRAME_SHADOW@;
  font-family: @FONT@;
}

.popup-menu-content,
.calendar,
.workspace-switcher {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border: @FRAME@;
  border-radius: @RADIUS@;
  box-shadow: 0 10px 24px @FRAME_SHADOW@;
  font-family: @FONT@;
}

.appmenu-sidebar {
  background-color: @ACCENT@;
  background-image: none;
  color: @ACCENT_FG@;
  border-right: 1px solid @BORDER@;
  padding: 8px;
}

.appmenu-main-box,
.appmenu-categories-box,
.appmenu-categories-applications-box,
.appmenu-applications-box,
.appmenu-favs-box,
.appmenu-system-box,
.appmenu-places-box {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
}

.appmenu-category-button,
.appmenu-sidebar-button,
.appmenu-system-button {
  color: @FG@;
  background-color: transparent;
  background-image: none;
  border: 1px solid transparent;
  border-radius: @CONTROL_RADIUS@;
  margin: 2px;
  padding: 7px 9px;
}

.appmenu-application-button {
  color: @FG@;
  background-color: @SURFACE@;
  background-image: none;
  border: 1px solid @BORDER@;
  border-radius: @CONTROL_RADIUS@;
  margin: 3px;
  padding: 8px;
}

.appmenu-category-button:hover,
.appmenu-category-button-selected,
.appmenu-application-button:hover,
.appmenu-application-button:focus,
.appmenu-sidebar-button:hover,
.appmenu-system-button:hover {
  color: @ACCENT_FG@;
  background-color: @ACCENT@;
  background-image: none;
  border-color: @ACCENT@;
}

.appmenu-application-button:hover,
.appmenu-application-button:focus {
  color: @ACCENT_FG@;
  background-color: @ACCENT@;
  background-image: none;
  border-color: @ACCENT@;
}

.appmenu-search-box,
.appmenu-search-entry {
  color: @FG@;
  background-color: @SURFACE@;
  background-image: none;
  border: 1px solid @BORDER@;
  border-radius: @CONTROL_RADIUS@;
  padding: 7px 9px;
}

#menu .menu-favorites-box {
  background-color: @ACCENT@;
  background-image: none;
  color: @ACCENT_FG@;
  border: 1px solid @BORDER@;
  border-radius: @CONTROL_RADIUS@;
  padding: 6px;
}

#menu .menu-categories-box,
#menu .menu-applications-box,
#menu .menu-applications-inner-box {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
}

#menu .menu-category-button,
#menu .menu-application-button,
#menu .menu-favorites-button,
.menu-item,
.popup-menu-item {
  color: @FG@;
  font-family: @FONT@;
  border-radius: @CONTROL_RADIUS@;
  padding: 6px 9px;
}

#menu .menu-category-button:hover,
#menu .menu-category-button-selected,
#menu .menu-application-button:hover,
#menu .menu-application-button-selected,
#menu .menu-favorites-button:hover,
#menu .menu-selected-app-box,
.menu-item:selected,
.menu-item:active,
.popup-menu-item:hover,
.button:checked {
  background-color: @ACCENT@;
  background-image: none;
  color: @ACCENT_FG@;
  border-color: @BORDER@;
}

#menu .menu-search-entry,
.entry,
StEntry {
  background-color: @SURFACE@;
  background-image: none;
  border: 1px solid @BORDER@;
  color: @FG@;
  font-family: @FONT@;
  border-radius: @CONTROL_RADIUS@;
  padding: 7px 9px;
  selection-background-color: @ACCENT@;
  selected-color: @ACCENT_FG@;
}

.button,
.menu-item {
  border-radius: @CONTROL_RADIUS@;
}

.button {
  background-color: @SURFACE@;
  background-image: @BUTTON_BG@;
  color: @FG@;
  border: @FRAME@;
  border-radius: @RADIUS@;
}

.button:hover {
  background-color: @ACCENT@;
  background-image: none;
  color: @ACCENT_FG@;
}

.separator,
StSeparator {
  background-color: @BORDER@;
}

.tooltip {
  background-color: @SURFACE@;
  background-image: none;
  color: @FG@;
  border: 1px solid @BORDER@;
  font-family: @FONT@;
}
