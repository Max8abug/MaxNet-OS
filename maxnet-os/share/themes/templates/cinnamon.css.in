/* MaxNet display theme adapted for Cinnamon. */
#panel,
.panel {
  background-color: @BG@;
  background-image: @PANEL_BG@;
  color: @FG@;
  font-family: @FONT@;
  border-top: 1px solid @BORDER@;
}

.menu,
.popup-menu-content,
.calendar,
.workspace-switcher {
  background-color: @SURFACE@;
  color: @FG@;
  border: @FRAME@;
  border-radius: @RADIUS@;
  font-family: @FONT@;
}

.menu-item:selected,
.menu .menu-item:active,
.button:checked {
  background-color: @ACCENT@;
  background-image: @PANEL_BG@;
  color: @ACCENT_FG@;
  border-color: @BORDER@;
}

.menu-item,
.button {
  color: @FG@;
  font-family: @FONT@;
}

.menu-item:hover,
.button:hover {
  background-color: @ACCENT@;
  background-image: @PANEL_BG@;
  color: @ACCENT_FG@;
}

.button,
.menu-item {
  border-radius: 2px;
}

.entry,
StEntry {
  background-color: @SURFACE@;
  color: @FG@;
  border: 1px solid @BORDER@;
  selection-background-color: @ACCENT@;
  selected-color: @ACCENT_FG@;
}

.separator,
StSeparator {
  background-color: @BORDER@;
}

.tooltip {
  background-color: @SURFACE@;
  color: @FG@;
  border: 1px solid @BORDER@;
  font-family: @FONT@;
}
